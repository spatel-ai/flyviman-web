# Copy to .env.local for local development. Never commit .env.local.
# Only NEXT_PUBLIC_ values belong here: they are compiled into the browser
# bundle, so they must be safe to publish. Secrets live in flyviman-api.

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Hosted with the API on an unrelated domain (D-065): proxy /api/v1 through
# this site so session cookies stay on one origin. Then set
#   NEXT_PUBLIC_API_URL=https://<this site>/api/v1
#   API_PROXY_TARGET=https://<the API's own address>   (no /api/v1, no slash)
# API_PROXY_TARGET=

# M7: Razorpay publishable key id (the secret stays in the API)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=
