# Copy to .env.local for local development. Never commit .env.local.
# NEXT_PUBLIC_ values are compiled into the browser bundle, so they must be
# safe to publish. API_PROXY_TARGET is read on the server only and is not a
# secret either. Secrets live in flyviman-api.

NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Hosted with the API on an unrelated domain (D-065): proxy /api/v1 through
# this site so session cookies stay on one origin. Then set
#   NEXT_PUBLIC_API_URL=https://<this site>/api/v1
#   API_PROXY_TARGET=https://<the API's own address>   (no /api/v1, no slash)
# API_PROXY_TARGET=

# M8: Razorpay publishable key id (the secret stays in the API)
# NEXT_PUBLIC_RAZORPAY_KEY_ID=

# Business details the client supplies later. Unset means "not shown" (or the
# built-in default for the contact details). An invalid value is ignored with
# a server warning. See src/lib/site-settings.ts.
# NEXT_PUBLIC_WHATSAPP_NUMBER=919779920011       digits with country code
# NEXT_PUBLIC_SOCIAL_INSTAGRAM=https://www.instagram.com/<profile>
# NEXT_PUBLIC_SOCIAL_FACEBOOK=https://www.facebook.com/<profile>
# NEXT_PUBLIC_SOCIAL_YOUTUBE=https://www.youtube.com/@<channel>
# NEXT_PUBLIC_SOCIAL_X=https://x.com/<profile>
# NEXT_PUBLIC_SOCIAL_LINKEDIN=https://www.linkedin.com/company/<profile>
# NEXT_PUBLIC_LOGO_PATH=/logo.svg                a file under public/
# NEXT_PUBLIC_CONTACT_EMAIL=info@flyviman.com
# NEXT_PUBLIC_CONTACT_PHONES=+91 97799 20011,+91 84471 73787
